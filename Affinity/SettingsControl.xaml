<UserControl x:Class="Affinity.SettingsControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <styles:SHTabControl>
            <styles:SHTabItem Header="Data">
                <StackPanel>
                    <styles:SHSection Title="Stored Distance">
                        <StackPanel Margin="12">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="320" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Padding="16,14"
                                        Background="#252525"
                                        BorderBrush="#2CB7F0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Foreground="#89D9FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="Most distance driven" />
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Text="{Binding FeaturedGameTab.GameName, TargetNullValue=No game data yet}" />
                                        <StackPanel Margin="0,10,0,0"
                                                    Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Bottom"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Text="{Binding FeaturedGameTab.TotalDistanceDisplay, StringFormat=F2, TargetNullValue=0.00}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       VerticalAlignment="Bottom"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DistanceUnitLabel}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#D8D8D8"
                                                   Text="{Binding FeaturedGameTab.TotalUsedTimeDisplay, StringFormat=Time driven: {0}, TargetNullValue=Time driven: 00:00:00}" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right"
                                               FontSize="12"
                                               Foreground="#B8B8B8"
                                               Text="{Binding TotalUsedTimeDisplay, StringFormat=All games total time: {0}}" />
                                    <StackPanel Margin="0,2,0,10"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <TextBlock FontSize="12"
                                                   Foreground="#B8B8B8"
                                                   Text="{Binding TotalDistanceDisplay, StringFormat=All games total distance: {0:F2}}" />
                                        <TextBlock Margin="4,0,0,0"
                                                   FontSize="12"
                                                   Foreground="#B8B8B8"
                                                   Text="{Binding DistanceUnitLabel}" />
                                    </StackPanel>

                                    <ItemsControl HorizontalAlignment="Right"
                                                  ItemsSource="{Binding GameTabs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2,0,0"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="{Binding GameName}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding TotalDistanceDisplay, StringFormat=F2}" />
                                                    <TextBlock Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="{Binding TotalUsedTimeDisplay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <styles:SHTabControl ItemsSource="{Binding GameTabs}"
                                                 SelectedItem="{Binding SelectedGameTab, Mode=TwoWay}"
                                                 DisplayMemberPath="GameName"
                                                 Height="600">
                                <styles:SHTabControl.ContentTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Grid.Column="0"
                                                    Padding="10,8"
                                                    Background="#252525"
                                                    BorderBrush="#3A3A3A"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock FontSize="11"
                                                               Foreground="#89D9FF"
                                                               FontWeight="SemiBold"
                                                               Text="Top track by distance" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding TopTrackSummary.TrackDisplayName, TargetNullValue=No track data yet}" />
                                                    <StackPanel Margin="0,4,0,0"
                                                                Orientation="Horizontal">
                                                        <TextBlock FontWeight="Bold"
                                                                   Text="{Binding TopTrackSummary.DistanceDisplay, StringFormat=F2, TargetNullValue=0.00}" />
                                                        <TextBlock Margin="4,0,0,0"
                                                                   Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                        <TextBlock Margin="10,0,0,0"
                                                                   Text="{Binding TopTrackSummary.UsedTimeDisplay, StringFormat=Time driven: {0}, TargetNullValue=Time driven: 00:00:00}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="0"
                                                    Grid.Column="2"
                                                    Padding="10,8"
                                                    Background="#252525"
                                                    BorderBrush="#3A3A3A"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock FontSize="11"
                                                               Foreground="#89D9FF"
                                                               FontWeight="SemiBold"
                                                               Text="Top car by distance" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding TopCarSummary.CarModel, TargetNullValue=No car data yet}" />
                                                    <StackPanel Margin="0,4,0,0"
                                                                Orientation="Horizontal">
                                                        <TextBlock FontWeight="Bold"
                                                                   Text="{Binding TopCarSummary.DistanceDisplay, StringFormat=F2, TargetNullValue=0.00}" />
                                                        <TextBlock Margin="4,0,0,0"
                                                                   Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                        <TextBlock Margin="10,0,0,0"
                                                                   Text="{Binding TopCarSummary.UsedTimeDisplay, StringFormat=Time driven: {0}, TargetNullValue=Time driven: 00:00:00}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Margin="0,0,0,8"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="Tracks" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="2"
                                                       Margin="0,0,0,8"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="Cars" />

                                            <DataGrid Grid.Row="3"
                                                      Grid.Column="0"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"
                                                      ItemsSource="{Binding TrackSummaries}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="*" Binding="{Binding TrackDisplayName}" Header="Track" />
                                                    <DataGridTextColumn Width="120" Binding="{Binding DistanceDisplay, StringFormat=F2}">
                                                        <DataGridTextColumn.Header>
                                                            <TextBlock Text="{Binding DataContext.DistanceColumnHeader, ElementName=Root}" />
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Width="100" Binding="{Binding UsedTimeDisplay}" Header="Time" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <DataGrid Grid.Row="3"
                                                      Grid.Column="2"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"
                                                      ItemsSource="{Binding CarSummaries}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="*" Binding="{Binding CarModel}" Header="Car" />
                                                    <DataGridTextColumn Width="120" Binding="{Binding DistanceDisplay, StringFormat=F2}">
                                                        <DataGridTextColumn.Header>
                                                            <TextBlock Text="{Binding DataContext.DistanceColumnHeader, ElementName=Root}" />
                                                        </DataGridTextColumn.Header>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Width="100" Binding="{Binding UsedTimeDisplay}" Header="Time" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </DataTemplate>
                                </styles:SHTabControl.ContentTemplate>
                            </styles:SHTabControl>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Width="90"
                                        Height="24"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Click="RefreshButton_Click"
                                        Content="Refresh" />
                            </Grid>

                        </StackPanel>
                    </styles:SHSection>

                    <StackPanel Margin="12,0,12,0" HorizontalAlignment="Right">
                        <TextBlock TextAlignment="Right"
                                   Foreground="{Binding StatusSectionForeground}"
                                   Text="{Binding DataStatus}" />
                        <TextBlock Margin="0,4,0,0"
                                   TextAlignment="Right"
                                   Foreground="{Binding StatusSectionForeground}"
                                   Text="{Binding CurrentContext}" />
                        <TextBlock Margin="0,4,0,0"
                                   TextAlignment="Right"
                                   Foreground="{Binding StatusSectionForeground}"
                                   Text="{Binding DatabasePath}" />
                    </StackPanel>
                </StackPanel>
            </styles:SHTabItem>

            <styles:SHTabItem Header="Settings">
                <StackPanel>
                    <styles:SHSection Title="General">
                        <StackPanel Margin="12">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="0,0,12,8"
                                           VerticalAlignment="Center"
                                           Text="Enable plugin" />
                                <CheckBox Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="0,0,0,8"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding Settings.EnablePlugin, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Text="Distance units" />
                                <CheckBox Grid.Row="1"
                                          Grid.Column="1"
                                          HorizontalAlignment="Left"
                                          Content="Display miles"
                                          Checked="DistanceUnitChanged"
                                          Unchecked="DistanceUnitChanged"
                                          IsChecked="{Binding Settings.DisplayInMiles, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Width="90" Click="SaveButton_Click" Content="Save" />
                                <Button Width="110" Margin="8,0,0,0" Click="ResetButton_Click" Content="Reset Settings" />
                            </StackPanel>
                        </StackPanel>
                    </styles:SHSection>

                    <styles:SHSection Title="Debug Logging">
                        <StackPanel Margin="12">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Text="Debug logging" />
                                <CheckBox Grid.Column="1"
                                          HorizontalAlignment="Left"
                                          Content="Write telemetry debug log"
                                          IsChecked="{Binding Settings.EnableDebugLogging, Mode=TwoWay}" />
                            </Grid>

                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                Debug logs are written to separate files per game. Use the checkboxes below to control which games produce telemetry logs when debug logging is enabled.
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding GameDebugLoggingOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,0,0,6"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </styles:SHSection>
                </StackPanel>
            </styles:SHTabItem>
        </styles:SHTabControl>
    </ScrollViewer>
</UserControl>
