<UserControl x:Class="Affinity.AffinitySimHub"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Affinity"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="540"
             d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <styles:SHTabControl ItemsSource="{Binding TopLevelTabs}">
            <styles:SHTabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </styles:SHTabControl.ItemTemplate>

            <styles:SHTabControl.Resources>
                <DataTemplate DataType="{x:Type local:AffinityOverviewTab}">
                    <StackPanel>
                        <styles:SHSection>
                            <StackPanel Margin="12">
                                <ItemsControl Margin="0,0,0,12"
                                              ItemsSource="{Binding DataContext.TopSummarySections, ElementName=Root}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,18">
                                                <TextBlock Margin="0,0,0,8"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Header}" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Padding="16,14"
                                                            Background="#252525"
                                                            BorderBrush="#2CB7F0"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <StackPanel>
                                                            <TextBlock Foreground="#89D9FF"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Text="Most distance driven" />
                                                            <TextBlock Margin="0,8,0,0"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Text="{Binding FeaturedGameTab.GameName, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="13"
                                                                       Foreground="#D8D8D8"
                                                                       Text="Game: "
                                                                       Visibility="Hidden" />
                                                            <StackPanel Margin="0,10,0,0"
                                                                        Orientation="Horizontal">
                                                                <TextBlock VerticalAlignment="Bottom"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Text="{Binding FeaturedGameTab.TotalDistanceDisplay, StringFormat=F2, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                                <TextBlock Margin="6,0,0,0"
                                                                           VerticalAlignment="Bottom"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       Foreground="#D8D8D8"
                                                                       Text="{Binding FeaturedGameTab.TotalUsedTimeDisplay, StringFormat=Time driven: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="2"
                                                            Padding="16,14"
                                                            Background="#252525"
                                                            BorderBrush="#2CB7F0"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <StackPanel>
                                                            <TextBlock Foreground="#89D9FF"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Text="Most distance on track" />
                                                            <TextBlock Margin="0,8,0,0"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Text="{Binding FeaturedTrackSummary.TrackDisplayName, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="13"
                                                                       Foreground="#D8D8D8"
                                                                       Text="{Binding FeaturedTrackSummary.GameName, StringFormat=Game: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                            <StackPanel Margin="0,10,0,0"
                                                                        Orientation="Horizontal">
                                                                <TextBlock VerticalAlignment="Bottom"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Text="{Binding FeaturedTrackSummary.DistanceDisplay, StringFormat=F2, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                                <TextBlock Margin="6,0,0,0"
                                                                           VerticalAlignment="Bottom"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       Foreground="#D8D8D8"
                                                                       Text="{Binding FeaturedTrackSummary.UsedTimeDisplay, StringFormat=Time driven: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="4"
                                                            Padding="16,14"
                                                            Background="#252525"
                                                            BorderBrush="#2CB7F0"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <StackPanel>
                                                            <TextBlock Foreground="#89D9FF"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Text="Most distance in car" />
                                                            <TextBlock Margin="0,8,0,0"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Text="{Binding FeaturedCarSummary.CarModel, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="13"
                                                                       Foreground="#D8D8D8"
                                                                       Text="{Binding FeaturedCarSummary.GameName, StringFormat=Game: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                            <StackPanel Margin="0,10,0,0"
                                                                        Orientation="Horizontal">
                                                                <TextBlock VerticalAlignment="Bottom"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Text="{Binding FeaturedCarSummary.DistanceDisplay, StringFormat=F2, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                                <TextBlock Margin="6,0,0,0"
                                                                           VerticalAlignment="Bottom"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                            </StackPanel>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       Foreground="#D8D8D8"
                                                                       Text="{Binding FeaturedCarSummary.UsedTimeDisplay, StringFormat=Time driven: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0,4,0,8"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="Game totals" />
                                <ItemsControl ItemsSource="{Binding DataContext.GameTabs, ElementName=Root}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="190"
                                                    Margin="0,0,10,10"
                                                    Padding="10,8"
                                                    Background="#252525"
                                                    BorderBrush="#3A3A3A"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <TextBlock FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding GameName}" />
                                                    <StackPanel Margin="0,6,0,0"
                                                                Orientation="Horizontal">
                                                        <TextBlock FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Text="{Binding TotalDistanceDisplay, StringFormat=F2}" />
                                                        <TextBlock Margin="5,2,0,0"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="#B8B8B8"
                                                               Text="{Binding TotalUsedTimeDisplay, StringFormat=Time driven: {0}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Width="90"
                                        Height="24"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Click="RefreshButton_Click"
                                        Content="Refresh" />
                            </StackPanel>
                        </styles:SHSection>

                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        HorizontalAlignment="Left">
                                <TextBlock FontSize="12"
                                           Foreground="#B8B8B8"
                                           Text="{Binding DataContext.TotalUsedTimeDisplay, ElementName=Root, StringFormat=All games total time: {0}}" />
                                <StackPanel Margin="0,2,0,10"
                                            Orientation="Horizontal">
                                    <TextBlock FontSize="12"
                                               Foreground="#B8B8B8"
                                               Text="{Binding DataContext.TotalDistanceDisplay, ElementName=Root, StringFormat=All games total distance: {0:F2}}" />
                                    <TextBlock Margin="4,0,0,0"
                                               FontSize="12"
                                               Foreground="#B8B8B8"
                                               Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock TextAlignment="Right"
                                           Foreground="{Binding DataContext.StatusSectionForeground, ElementName=Root}"
                                           Text="{Binding DataContext.DataStatus, ElementName=Root}" />
                                <TextBlock Margin="0,4,0,0"
                                           TextAlignment="Right"
                                           Foreground="{Binding DataContext.StatusSectionForeground, ElementName=Root}"
                                           Text="{Binding DataContext.CurrentContext, ElementName=Root}" />
                                <TextBlock Margin="0,4,0,0"
                                           TextAlignment="Right"
                                           Foreground="{Binding DataContext.StatusSectionForeground, ElementName=Root}"
                                           Text="{Binding DataContext.DatabasePath, ElementName=Root}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="{x:Type local:GameDistanceTab}">
                    <Grid Margin="12,8,12,12"
                          MinHeight="560">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Padding="16,14"
                                Background="#252525"
                                BorderBrush="#2CB7F0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Foreground="#89D9FF"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Top track by distance" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Text="{Binding TopTrackSummary.TrackDisplayName, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                <StackPanel Margin="0,10,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Bottom"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Text="{Binding TopTrackSummary.DistanceDisplay, StringFormat=F2, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Bottom"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#D8D8D8"
                                           Text="{Binding TopTrackSummary.UsedTimeDisplay, StringFormat=Time driven: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Padding="16,14"
                                Background="#252525"
                                BorderBrush="#2CB7F0"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Foreground="#89D9FF"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="Top car by distance" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Text="{Binding TopCarSummary.CarModel, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                <StackPanel Margin="0,10,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Bottom"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Text="{Binding TopCarSummary.DistanceDisplay, StringFormat=F2, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Bottom"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="{Binding DataContext.DistanceUnitLabel, ElementName=Root}" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#D8D8D8"
                                           Text="{Binding TopCarSummary.UsedTimeDisplay, StringFormat=Time driven: {0}, FallbackValue={x:Static sys:String.Empty}, TargetNullValue={x:Static sys:String.Empty}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,0,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Tracks" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Margin="0,0,0,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Cars" />

                        <DataGrid Grid.Row="3"
                                  Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding TrackSummaries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding TrackDisplayName}" Header="Track" />
                                <DataGridTextColumn Width="120" Binding="{Binding DistanceDisplay, StringFormat=F2}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding DataContext.DistanceColumnHeader, ElementName=Root}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" Binding="{Binding UsedTimeDisplay}" Header="Time" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Row="3"
                                  Grid.Column="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding CarSummaries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*" Binding="{Binding CarModel}" Header="Car" />
                                <DataGridTextColumn Width="120" Binding="{Binding DistanceDisplay, StringFormat=F2}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding DataContext.DistanceColumnHeader, ElementName=Root}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Width="100" Binding="{Binding UsedTimeDisplay}" Header="Time" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DataTemplate>

                <DataTemplate DataType="{x:Type local:AffinitySettingsTab}">
                    <StackPanel>
                        <styles:SHSection Title="General">
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Margin="0,0,12,8"
                                               VerticalAlignment="Center"
                                               Text="Distance units" />
                                    <CheckBox Grid.Row="0"
                                              Grid.Column="1"
                                              Margin="0,0,0,8"
                                              HorizontalAlignment="Left"
                                              Content="Display miles"
                                              Checked="DistanceUnitChanged"
                                              Unchecked="DistanceUnitChanged"
                                              IsChecked="{Binding DataContext.Settings.DisplayInMiles, ElementName=Root, Mode=TwoWay}" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="Version" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Text="{Binding DataContext.PluginVersionDisplay, ElementName=Root}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Width="90" Click="SaveButton_Click" Content="Save" />
                                    <Button Width="110" Margin="8,0,0,0" Click="ResetButton_Click" Content="Reset Settings" />
                                </StackPanel>
                            </StackPanel>
                        </styles:SHSection>

                        <styles:SHSection Title="Debug Logging">
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Text="Debug logging" />
                                    <CheckBox Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              Content="Write telemetry debug log"
                                              IsChecked="{Binding DataContext.Settings.EnableDebugLogging, ElementName=Root, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                                    Debug logs are written to separate files per game. Use the checkboxes below to control which games produce telemetry logs when debug logging is enabled.
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding DataContext.GameDebugLoggingOptions, ElementName=Root}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,0,0,6"
                                                      Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </styles:SHSection>
                    </StackPanel>
                </DataTemplate>
            </styles:SHTabControl.Resources>
        </styles:SHTabControl>
    </ScrollViewer>
</UserControl>
